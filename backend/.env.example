# Copy this file to .env and fill in the values. Never commit the real .env.
# Passwords and API keys (SMTP_PASS, RESEND_API_KEY, ...) can go in backend/.env.local instead:
# it is loaded after .env, overrides it, and is git-ignored as well.

# ── Database ──
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
# Use a long random password (12+ characters), never one you use elsewhere.
DB_PASSWORD=
# true for hosted PostgreSQL that requires TLS (set DB_SSL_REJECT_UNAUTHORIZED=false only for self-signed certificates)
DB_SSL=false
# Production only: the server does NOT alter tables at startup. Set true for ONE deploy after adding model fields.
# DB_SYNC_ALTER=false

# ── Auth ──
# At least 32 random characters; the server refuses to start in production without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everybody out.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
NODE_ENV=development
PORT=8001
# Where the portal runs. Used in email links ("Open in the portal"), invite and password reset links.
# Also the ONLY origin(s) allowed to call the API from a browser (CORS) and to submit changes (CSRF check).
# Several origins: separate with commas. Use https:// in production.
FRONTEND_URL=http://localhost:3000
# Behind a proxy / load balancer (Render, Heroku, nginx...) set the number of proxies, usually 1, so rate limits
# see real client IPs. Leave unset when the app is reached directly.
# TRUST_PROXY=1
# Cookie SameSite: strict | lax | none. Default: none in production (front end and API on different sites), lax in development.
# Use strict when both are served from the same site (for example app.example.com and api.example.com).
# COOKIE_SAMESITE=
# Rate limits (attempts per 15 minutes): defaults shown
# RATE_LIMIT_API=1000
# RATE_LIMIT_LOGIN=10

# ── Email delivery ──
# Notifications are emailed to agents as well as shown in the portal. Choose ONE provider.
# With neither set, emails are only written to the server log (fine for development).
#
# Option A: Resend (https://resend.com)
# RESEND_API_KEY=
#
# Option B: any SMTP server
SMTP_HOST= 
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false        # true for port 465
#
# Sender shown on every email, for example: QStudy <no-reply@yourdomain.com>
# (with Resend the domain must be verified; the default onboarding@resend.dev only reaches your own address)
# SENDER_EMAIL=
#
# Staff get notifications in the portal only. Set to true to email them as well.
# EMAIL_STAFF_NOTIFICATIONS=false

# ── Student verification ──
# Set to true to allow student verification only after the student reaches Registration in the visa pipeline.
VERIFICATION_REQUIRES_ENROLLMENT=false

# Live chat: the QStudy WhatsApp number (digits with country code) turns on the "Chat on WhatsApp" button
# WHATSAPP_NUMBER=60123456789
# WHATSAPP_MESSAGE=Hello QStudy, I need help with the agent portal.

# ── First admin account ──
# There is no default admin password. To create an admin run (password at least 10 characters, letter + number):
#   PowerShell:  $env:ADMIN_PASSWORD='...'; npm run create-admin -- you@company.com "Your Name"
#   bash:        ADMIN_PASSWORD='...' npm run create-admin -- you@company.com "Your Name"
# Remove ADMIN_PASSWORD from the environment afterwards.
# Development only: sample agents and students with random passwords.
# SEED_SAMPLE_DATA=false
